# ----------------------------------------------------------------------------
# FYI-Agent 환경설정 예시. 복사해서 사용하세요:  cp .env.example .env
# ----------------------------------------------------------------------------

# --- 프로바이더 선택 ---------------------------------------------------------
# 두 가지 프로필을 설정만으로 전환할 수 있습니다.
#   1) Claude 프로필 (품질 우선, API 키 필요):
#        LLM_PROVIDER=anthropic / EMBEDDING_PROVIDER=huggingface
#   2) 로컬 Ollama 프로필 (무료·오프라인, ollama serve 필요):
#        LLM_PROVIDER=ollama / EMBEDDING_PROVIDER=ollama
# 주의: EMBEDDING_PROVIDER/모델을 바꾸면 벡터 차원이 달라지므로
#       반드시  python scripts/ingest.py --reset  으로 재인덱싱하세요.
LLM_PROVIDER=anthropic         # anthropic | ollama
EMBEDDING_PROVIDER=huggingface # huggingface | ollama

# --- Anthropic / LLM (LLM_PROVIDER=anthropic 일 때) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# claude-opus-4-8 (최고 성능) | claude-sonnet-4-6 (균형) | claude-haiku-4-5-20251001 (빠름)
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# --- Embeddings: huggingface (EMBEDDING_PROVIDER=huggingface 일 때, CUDA 자동 사용) ---
# 한국어/다국어에 강한 BAAI/bge-m3 를 기본값으로 사용합니다.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto          # auto | cuda | cpu

# --- Ollama (LLM_PROVIDER=ollama 또는 EMBEDDING_PROVIDER=ollama 일 때) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma3:1b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m

# --- 위키 문서 ---
# 컨테이너 내부 경로 (docker-compose 가 WIKI_HOST_PATH 를 여기에 마운트)
WIKI_PATH=/data/wiki
# 호스트의 실제 위키 문서 디렉터리 (예: 크롤링된 마크다운 저장 위치)
WIKI_HOST_PATH=/examples/wiki
WIKI_GLOB=**/*.md

# --- 벡터 스토어 (Chroma, 영속화) ---
VECTOR_STORE_DIR=/data/vectorstore
COLLECTION_NAME=fyi_wiki

# --- 청킹 / 검색 ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5

# --- API / 앱 ---
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- 프록시 (배포 우분투가 프록시 서버를 사용하는 경우만 값 입력) ---
# 여기 한 곳만 채우면 다음 모든 경로에 자동 적용됩니다:
#   - Docker 빌드 시 pip 설치        (docker-compose build.args 로 전달)
#   - 런타임 컨테이너의 외부 호출     (Claude API, HuggingFace 모델 다운로드)
#   - 소문자 변수(http_proxy 등)도 컨테이너에 함께 노출
# 비워두면 프록시 미사용. NO_PROXY 에는 내부/로컬 주소를 반드시 포함하세요
# (헬스체크가 localhost 로 접속하므로 프록시를 타면 실패합니다).
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
